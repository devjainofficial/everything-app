# ─────────────────────────────────────────────────────────────
# TEMPLATE — safe to commit. Copy this file to ".env" and put your
# REAL values there. .env is gitignored, so the key never leaves
# this machine. NEVER paste your real Azure key into chat or commit it.
# ─────────────────────────────────────────────────────────────

# Azure OpenAI (your company deployment). The gateway reads these at runtime.
AZURE_API_KEY=replace-with-your-azure-key
AZURE_API_BASE=https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_API_VERSION=2024-08-01-preview
AZURE_DEPLOYMENT_NAME=your-deployment-name
